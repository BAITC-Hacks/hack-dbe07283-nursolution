OPENAI_API_KEY=sk-ваш-ключ-сюда
# false для демо без обращений к OpenAI
MATCHER_USE_LLM=true
# Необязательно: по умолчанию используется CSV в data/
# MATCHER_CSV_PATH=data/hackathon dataset anonymized .csv
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Внешний порт Docker Compose (обычный uvicorn использует свой --port)
APP_PORT=8080
# Бюджет обработки запроса (больше 0, не больше 9 секунд)
MATCHER_TIMEOUT_SECONDS=8
# Кеш проверенных объяснений на процесс; 0 отключает кеш
EXPLANATION_CACHE_TTL_SECONDS=600
EXPLANATION_CACHE_MAX_ENTRIES=256
# Максимум одновременно выполняющихся LLM-вызовов на процесс
LLM_MAX_CONCURRENCY=4

# Источник каталога: csv или postgres
CATALOG_BACKEND=csv
# Для локального Python укажите postgresql://nur:пароль@127.0.0.1:55432/nur.
# Docker не использует DATABASE_URL: оба сервера могут работать одновременно.
DATABASE_URL=
# Необязательно: свой URL базы для Docker (например, внешняя PostgreSQL).
# Пусто: Compose подключится к db:5432, используя POSTGRES_PASSWORD.
DOCKER_DATABASE_URL=
POSTGRES_PASSWORD=nur_local_dev
POSTGRES_PORT=55432
# Отдельный ключ редактора; пусто = редактор отключён.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
